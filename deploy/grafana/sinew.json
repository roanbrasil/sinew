          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(sinew_run_duration_seconds_bucket{project=~\"$project\",kind=\"graph\",name=~\"$graph\"}[$__rate_interval])))",
          "legendFormat": "p50"
