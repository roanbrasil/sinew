          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(sinew_run_duration_seconds_bucket{project=~\"$project\",kind=\"graph\",name=~\"$graph\"}[$__rate_interval])))",
          "legendFormat": "p95"
