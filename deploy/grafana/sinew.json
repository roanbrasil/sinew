          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(sinew_run_duration_seconds_bucket{project=~\"$project\",kind=\"graph\",name=~\"$graph\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "description": "Quantiles estimated from the sinew_run_duration_seconds histogram of graph runs."
